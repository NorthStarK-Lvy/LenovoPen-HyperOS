<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.alyssum.relegion.permission.REQUEST_STATE" android:protectionLevel="signature"/>
    <uses-permission android:name="com.alyssum.relegion.permission.REQUEST_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <queries>
        <package android:name="com.miui.securitycore"/>
        <package android:name="com.milink.service"/><package android:name="com.xiaomi.mirror"/>
        <package android:name="com.tophatch.concepts.china"/><package android:name="com.tophatch.concepts"/>
        <package android:name="com.lenovo.pendemo"/><package android:name="com.fiistudio.fiinote"/>
        <package android:name="com.wacom.bamboopapertab"/><package android:name="com.medibang.android.paint.tablet"/>
        <package android:name="jp.ne.ibis.ibispaintx.app.hms"/><package android:name="com.zui.notes"/>
        <package android:name="com.microsoft.office.onenote"/><package android:name="com.myscript.nebo"/>
        <package android:name="com.google.android.keep"/><package android:name="com.flexcil.flexcilnote"/>
        <package android:name="com.topstack.kilonotes.pad"/><package android:name="com.orion.notein"/>
        <package android:name="com.lenovo.styluspen"/>
    </queries>
    <application android:label="@string/app_name" android:description="@string/module_description" android:icon="@mipmap/ic_relegion" android:roundIcon="@mipmap/ic_relegion"
        android:name=".hyperconnect.app.HyperConnectApplication"
        android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider android:name=".StateProvider" android:authorities="com.alyssum.relegion.state" android:exported="true"/>
        <receiver android:name=".hyperconnect.platform.HookStatusReceiver" android:exported="true"
            android:directBootAware="true" android:permission="android.permission.INTERACT_ACROSS_USERS"/>
    </application>
</manifest>
